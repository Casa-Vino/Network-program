<!-- Merge these into android/app/src/main/AndroidManifest.xml, as direct
     children of <manifest>, ABOVE the <application> tag. -->

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- Needed to receive mDNS multicast on Android. -->
<uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

<!-- Reading Wi-Fi details (IP/gateway) requires location on Android < 13. -->
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

<!-- Android 13+ replacement that avoids the location requirement. -->
<uses-permission
    android:name="android.permission.NEARBY_WIFI_DEVICES"
    android:usesPermissionFlags="neverForLocation" />
